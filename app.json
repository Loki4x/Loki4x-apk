{
  "expo": {
    "name": "Loki4x Academy",
    "slug": "loki4x-academy",
    "scheme": "loki4x",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050810",
    "android": {
      "package": "id.web.loki4xacademy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050810",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "id.web.loki4xacademy.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5F85DB",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
